# Copy to .env and set strong values before docker compose -f docker-compose.prod.yml up

POSTGRES_USER=wpb
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=diswallet

HSM_PIN=change-me-hsm-pin
WALLET_DISCLOSURES_ENCRYPTION_KEY=base64-32-byte-key
WPB_TRANSACTION_LOG_ENCRYPTION_KEY=base64-32-byte-key
WPB_TRANSACTION_LOG_INTEGRITY_KEY=base64-32-byte-key

WPB_STATUS_LIST_SIGNING_KEY_PEM_PATH=file:/run/secrets/status-list-signing-key.pem
WPB_MDOC_ISSUER_KEY_PEM_PATH=file:/run/secrets/mdoc-issuer-key.pem

WALLET_RP_ID=wpb.example.com
WALLET_ORIGINS=https://wpb.example.com

WPB_PORT=8080

# Host paths mounted into the WPB container for PKCS#11 (see docker-compose.prod.yml)
SOFTHSM_LIB_DIR=/usr/lib/x86_64-linux-gnu/softhsm
SOFTHSM_TOKEN_DIR=/var/lib/softhsm/tokens
SOFTHSM2_CONF=/etc/softhsm/softhsm2.conf
